# Copie este arquivo para ".env" e preencha. O arquivo .env NUNCA vai para o GitHub.

# 1 = modo desenvolvimento (recarrega sozinho). So roda em 127.0.0.1.
FLASK_DEBUG=1

# Chave da sessao (minimo 32 caracteres). Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Banco PostgreSQL local
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dgp
DB_USER=dgp_app
DB_PASSWORD=

# 1 = valida os digitos verificadores de CPF/CNPJ no cadastro de clientes.
# Use 0 apenas se precisar cadastrar documentos ficticios para demonstracao.
VALIDAR_DIGITO_DOCUMENTO=1
